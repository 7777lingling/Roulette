<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="Python FastCGI" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\Users\WH\anaconda3\python.exe|C:\Users\WH\anaconda3\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="FlaskApp" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="app.py/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <appSettings>
    <!-- 指定 Flask app.py 裡的 app 實例 -->
    <add key="WSGI_HANDLER" value="app.app" />
    
    <!-- 指定 Flask 專案根目錄 -->
    <add key="PYTHONPATH" value="E:\Deploy\Roulette" />
  </appSettings>
</configuration>
